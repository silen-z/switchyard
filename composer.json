{
    "name": "silenz/switchyard",
    "description": "PSR-7/15 HTTP routing layer on top of Beeline's compiled route table.",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "SilenZ\\Switchyard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilenZ\\Switchyard\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Pavel Hrách",
            "email": "pavel@hrach.email"
        }
    ],
    "require": {
        "php": ">=8.4",
        "silenz/beeline": "^0.1",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-factory": "^1.1",
        "relay/relay": "^3.0",
        "zircote/swagger-php": "^6.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "nyholm/psr7": "^1.8"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../beeline"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-html var/coverage --coverage-text"
    }
}
